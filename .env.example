# ─── Shopify Admin API ────────────────────────────────────────────────────────
# Your store's myshopify.com domain (no protocol, no trailing slash).
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com

# Pin to the latest stable Admin API version.
# https://shopify.dev/docs/api/admin-graphql
SHOPIFY_API_VERSION=2026-07

# ─── Shopify auth: pick ONE of the two methods below ──────────────────────────
#
# METHOD 1 (recommended) — Dev Dashboard app, client-credentials grant.
# Legacy custom apps (shpat_ tokens) can no longer be created as of 2026-01-01,
# so new setups use this. Create the app at https://dev.shopify.com, install it
# on your store, then copy its Client ID + Client secret here. The server
# exchanges these for a short-lived access token and refreshes it automatically.
# The app and store must belong to the same Shopify organization.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#
# METHOD 2 (legacy) — a static Admin API token from a custom app created BEFORE
# 2026-01-01. Leave CLIENT_ID/SECRET blank and set this instead. NEVER commit it.
# SHOPIFY_ACCESS_TOKEN=shpat_xxx

# ─── MCP endpoint protection (both layers) ────────────────────────────────────
# Layer 1: secret path segment. MCP is served at /mcp/{MCP_PATH_SECRET}.
# Use 32+ random chars, e.g. `openssl rand -hex 24`.
MCP_PATH_SECRET=change-me-to-a-long-random-string-32-plus-chars

# Layer 2 (optional): bearer token. When set, requests must send
# `Authorization: Bearer {MCP_AUTH_TOKEN}`. Leave blank to disable layer 2.
MCP_AUTH_TOKEN=

# ─── Server behaviour ─────────────────────────────────────────────────────────
# Register write/mutation tools only when this is exactly "true".
# Requires the write_* access scopes on the app (see README).
ENABLE_WRITES=true

PORT=3000
LOG_LEVEL=info

# ─── eBay (optional second backend) ──────────────────────────────────────────
# When EBAY_CLIENT_ID + EBAY_CLIENT_SECRET are BOTH set, the eBay tools
# (ebay_*) are registered so this server can also talk to eBay's REST APIs
# (Sell / Buy / Commerce / Account / Marketing / …). Leave both blank to
# disable eBay entirely. Create an app at https://developer.ebay.com and copy
# its App ID (Client ID) + Cert ID (Client secret) here.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
#
# User token (recommended, required for the Sell APIs). Generate a
# refresh token via the eBay OAuth user-consent flow (Sell scopes). The server
# exchanges it for a short-lived user access token and refreshes automatically.
# Without it, only client-credentials app-token endpoints work and EBAY_SCOPES
# becomes required. NEVER commit a real token.
EBAY_REFRESH_TOKEN=
#
# Space-separated OAuth scopes. Optional with a refresh token (the token's own
# granted scopes are used); required when falling back to a client-credentials
# app token. e.g.
# EBAY_SCOPES=https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account
EBAY_SCOPES=
#
# Default marketplace, sent as X-EBAY-C-MARKETPLACE-ID (default EBAY_US).
EBAY_MARKETPLACE_ID=EBAY_US
#
# "production" (default) or "sandbox" — selects api.ebay.com vs api.sandbox.ebay.com.
EBAY_ENV=production
#
# eBay Marketplace Account Deletion/Closure notification endpoint. eBay requires
# a working endpoint (or an exemption) before a PRODUCTION keyset activates, so
# set these two together to expose it. The server then serves the challenge +
# notification handler at the pathname of the URL below (unauthenticated — eBay
# calls it directly).
#   1. Invent a verification token: 32–80 chars, letters/digits/_/- only.
#      e.g. `openssl rand -hex 24`
#   2. Set the URL to your public HTTPS base + that path, EXACTLY as you register
#      it in eBay's "Marketplace Account Deletion" form (it's hashed, so it must match).
# EBAY_DELETION_VERIFICATION_TOKEN=
# EBAY_DELETION_ENDPOINT_URL=https://your-tunnel-host.example.com/ebay/deletion

# ─── Cloudflare Tunnel (docker-compose only) ──────────────────────────────────
# Token for the `cloudflared` service. Not read by the MCP server itself.
TUNNEL_TOKEN=
